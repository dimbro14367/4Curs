<Window x:Class="InsuranceApp.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник"
        Height="620" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource LightBgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#8E44AD" Padding="20,18">
            <StackPanel>
                <TextBlock x:Name="lblTitle" Text="Сотрудник" FontSize="18"
                           FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Заполните учётные данные сотрудника"
                           FontSize="11" Foreground="#E8DAEF" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <TextBlock Text="Логин *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtLogin" Height="34" Margin="0,0,0,12"/>

                <TextBlock x:Name="lblPasswordHint" Text="Пароль *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtPassword" Height="34" Margin="0,0,0,12"/>

                <TextBlock Text="Роль *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbRole" Height="34" Margin="0,0,0,12"
                          DisplayMemberPath="RoleName" SelectedValuePath="RoleID"/>

                <TextBlock Text="Фамилия *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtLastName" Height="34" Margin="0,0,0,12"/>

                <TextBlock Text="Имя *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtFirstName" Height="34" Margin="0,0,0,12"/>

                <TextBlock Text="Отчество" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtMiddleName" Height="34" Margin="0,0,0,12"/>

                <TextBlock Text="Телефон" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtPhone" Height="34" Margin="0,0,0,15"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#BDC3C7"
                BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Click="BtnCancel_Click"
                        Style="{StaticResource BaseButtonStyle}"
                        Background="#95A5A6" Padding="20,10" Margin="0,0,10,0"/>
                <Button Content="Сохранить" Click="BtnSave_Click"
                        Style="{StaticResource BaseButtonStyle}"
                        Background="#8E44AD" Padding="20,10"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>