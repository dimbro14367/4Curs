<Window x:Class="InsuranceApp.CreateContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление договора"
        Height="660" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource LightBgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Padding="20,18">
            <StackPanel>
                <TextBlock Text="Новый страховой договор" FontSize="18"
                           FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="lblClientName" FontSize="11"
                           Foreground="#D6EAF8" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <TextBlock Text="Номер договора *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtContractNumber" Height="34" Margin="0,0,0,12"/>

                <TextBlock Text="Вид страхования *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbInsuranceType" Height="34" Margin="0,0,0,12"
                          DisplayMemberPath="TypeName" SelectedValuePath="TypeID"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Страховая сумма *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtInsuredSum" Height="34"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Премия (цена) *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtPremium" Height="34"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Дата начала *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DatePicker x:Name="dpStartDate" Height="34"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Дата окончания *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DatePicker x:Name="dpEndDate" Height="34"/>
                    </StackPanel>
                </Grid>

                <Border Background="#FEF9E7" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="ℹ  Договор будет создан со статусом"
                                   FontSize="12" Foreground="#7D6608" FontWeight="SemiBold"/>
                        <TextBlock Text="«Ожидает решения андеррайтера»"
                                   FontSize="12" Foreground="#7D6608"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#BDC3C7"
                BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Click="BtnCancel_Click"
                        Style="{StaticResource BaseButtonStyle}"
                        Background="#95A5A6" Padding="20,10" Margin="0,0,10,0"/>
                <Button Content="Создать договор" Click="BtnSave_Click"
                        Style="{StaticResource BaseButtonStyle}"
                        Background="{StaticResource AccentBrush}" Padding="20,10"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>