<Window x:Class="InsuranceApp.AgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Страховая компания — Агент"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource LightBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- БОКОВАЯ ПАНЕЛЬ -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,25,20,0">
                    <TextBlock Text="🛡" FontSize="32" Foreground="White"/>
                    <TextBlock Text="Страховая" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,5,0,0"/>
                    <TextBlock Text="компания" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <Border Background="#34495E" CornerRadius="6" Padding="10" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Сотрудник" FontSize="11" Foreground="#95A5A6"/>
                            <TextBlock x:Name="lblUserName" FontSize="14" FontWeight="Bold"
                                       Foreground="White" Margin="0,2,0,0"/>
                            <TextBlock x:Name="lblRoleName" FontSize="11" Foreground="#3498DB"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="15,25,15,0">
                    <Button Content="🏠  Главное меню" Click="BtnHome_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="Transparent" Height="40" Margin="0,0,0,5"
                            HorizontalContentAlignment="Left" Padding="15,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="15,0,15,20">
                    <Button Content="🚪  Выйти" Click="BtnLogout_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="#E74C3C" Height="40"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ОБЛАСТЬ КОНТЕНТА -->
        <Grid Grid.Column="1">
            <!-- Главное меню: плитки -->
            <Grid x:Name="pnlMenu" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,25">
                    <TextBlock Text="Главное меню агента" Style="{StaticResource HeaderTextStyle}"/>
                    <TextBlock Text="Выберите действие для начала работы"
                               Style="{StaticResource SubHeaderTextStyle}" Margin="0,5,0,0"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" VerticalAlignment="Top">
                    <!-- Плитка: Добавить клиента -->
                    <Button Click="BtnAddClient_Click"
                            Style="{StaticResource TileButtonStyle}"
                            Background="{StaticResource GreenBrush}">
                        <StackPanel>
                            <TextBlock Text="➕" FontSize="36" HorizontalAlignment="Center" Foreground="White"/>
                            <TextBlock Text="Новый клиент" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" Foreground="White" Margin="0,6,0,2"/>
                            <TextBlock Text="Регистрация клиента" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="#D5F5E3"/>
                        </StackPanel>
                    </Button>

                    <!-- Плитка: Оформить договор -->
                    <Button Click="BtnCreateContract_Click"
                            Style="{StaticResource TileButtonStyle}"
                            Background="{StaticResource AccentBrush}">
                        <StackPanel>
                            <TextBlock Text="📄" FontSize="36" HorizontalAlignment="Center" Foreground="White"/>
                            <TextBlock Text="Оформить договор" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" Foreground="White" Margin="0,6,0,2"/>
                            <TextBlock Text="Страхование клиента" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="#D6EAF8"/>
                        </StackPanel>
                    </Button>

                    <!-- Плитка: Страховой случай -->
                    <Button Click="BtnCreateCase_Click"
                            Style="{StaticResource TileButtonStyle}"
                            Background="{StaticResource OrangeBrush}">
                        <StackPanel>
                            <TextBlock Text="⚠" FontSize="36" HorizontalAlignment="Center" Foreground="White"/>
                            <TextBlock Text="Запрос выплаты" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" Foreground="White" Margin="0,6,0,2"/>
                            <TextBlock Text="Страховой случай" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="#FAE5D3"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>

            <!-- Область: Клиенты (список) -->
            <Grid x:Name="pnlClients" Margin="30" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Клиенты" Style="{StaticResource HeaderTextStyle}"/>
                    <TextBlock x:Name="lblClientsSubtitle"
                               Style="{StaticResource SubHeaderTextStyle}" Margin="0,5,0,0"/>
                </StackPanel>

                <DataGrid x:Name="dgClients" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="White" RowBackground="White"
                          AlternatingRowBackground="#F8F9FA"
                          BorderBrush="#BDC3C7" BorderThickness="1"
                          FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ClientID}" Width="50"/>
                        <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="140"/>
                        <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="120"/>
                        <DataGridTextColumn Header="Отчество" Binding="{Binding MiddleName}" Width="140"/>
                        <DataGridTextColumn Header="Дата рождения" Binding="{Binding BirthDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="150"/>
                        <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Статусная строка -->
            <Border VerticalAlignment="Bottom" Background="White"
                    BorderBrush="#BDC3C7" BorderThickness="0,1,0,0" Padding="15,8">
                <TextBlock x:Name="lblStatus" FontSize="12" Foreground="{StaticResource GreenBrush}"
                           Text="Готово к работе"/>
            </Border>
        </Grid>
    </Grid>
</Window>