<Window x:Class="InsuranceApp.UnderwriterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Страховая компания — Отдел обработки"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource LightBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- БОКОВАЯ ПАНЕЛЬ -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,25,20,0">
                    <TextBlock Text="🛡" FontSize="32" Foreground="White"/>
                    <TextBlock Text="Страховая" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,5,0,0"/>
                    <TextBlock Text="компания" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <Border Background="#34495E" CornerRadius="6" Padding="10" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Сотрудник" FontSize="11" Foreground="#95A5A6"/>
                            <TextBlock x:Name="lblUserName" FontSize="14" FontWeight="Bold"
                                       Foreground="White" Margin="0,2,0,0"/>
                            <TextBlock x:Name="lblRoleName" FontSize="11" Foreground="#3498DB"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="15,25,15,0">
                    <Button Content="🏠  Главное меню" Click="BtnHome_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="Transparent" Height="40" Margin="0,0,0,5"
                            HorizontalContentAlignment="Left" Padding="15,0"/>
                    <Button Content="📄  Договоры" Click="BtnContracts_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="Transparent" Height="40" Margin="0,0,0,5"
                            HorizontalContentAlignment="Left" Padding="15,0"/>
                    <Button Content="⚠  Выплаты" Click="BtnCases_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="Transparent" Height="40" Margin="0,0,0,5"
                            HorizontalContentAlignment="Left" Padding="15,0"/>
                    <Button Content="📊  Отчёт" Click="BtnReport_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="Transparent" Height="40"
                            HorizontalContentAlignment="Left" Padding="15,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="15,0,15,20">
                    <Button Content="🚪  Выйти" Click="BtnLogout_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="#E74C3C" Height="40"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ОБЛАСТЬ КОНТЕНТА -->
        <Grid Grid.Column="1">
            <!-- Главное меню: плитки -->
            <Grid x:Name="pnlMenu" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,25">
                    <TextBlock Text="Главное меню отдела обработки" Style="{StaticResource HeaderTextStyle}"/>
                    <TextBlock Text="Принимайте решения по договорам и выплатам"
                               Style="{StaticResource SubHeaderTextStyle}" Margin="0,5,0,0"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" VerticalAlignment="Top">
                    <Button Click="BtnContracts_Click"
                            Style="{StaticResource TileButtonStyle}"
                            Background="{StaticResource AccentBrush}">
                        <StackPanel>
                            <TextBlock Text="📄" FontSize="36" HorizontalAlignment="Center" Foreground="White"/>
                            <TextBlock Text="Договоры" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" Foreground="White" Margin="0,6,0,2"/>
                            <TextBlock Text="Ожидают решения" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="#D6EAF8"/>
                        </StackPanel>
                    </Button>

                    <Button Click="BtnCases_Click"
                            Style="{StaticResource TileButtonStyle}"
                            Background="{StaticResource OrangeBrush}">
                        <StackPanel>
                            <TextBlock Text="⚠" FontSize="36" HorizontalAlignment="Center" Foreground="White"/>
                            <TextBlock Text="Выплаты" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" Foreground="White" Margin="0,6,0,2"/>
                            <TextBlock Text="Страховые случаи" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="#FAE5D3"/>
                        </StackPanel>
                    </Button>

                    <Button Click="BtnReport_Click"
                            Style="{StaticResource TileButtonStyle}"
                            Background="{StaticResource GreenBrush}">
                        <StackPanel>
                            <TextBlock Text="📊" FontSize="36" HorizontalAlignment="Center" Foreground="White"/>
                            <TextBlock Text="Отчёт" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" Foreground="White" Margin="0,6,0,2"/>
                            <TextBlock Text="Выплаты за период" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="#D5F5E3"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>

            <!-- Договоры -->
            <Grid x:Name="pnlContracts" Margin="30" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Договоры на рассмотрении" Style="{StaticResource HeaderTextStyle}"/>
                    <TextBlock Style="{StaticResource SubHeaderTextStyle}" Margin="0,5,0,0"
                               Text="Выберите договор и примите решение"/>
                </StackPanel>

                <DataGrid x:Name="dgPendingContracts" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="White" RowBackground="White"
                          AlternatingRowBackground="#F8F9FA" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ContractID}" Width="50"/>
                        <DataGridTextColumn Header="Номер" Binding="{Binding ContractNumber}" Width="130"/>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding ins_Clients.LastName}" Width="150"/>
                        <DataGridTextColumn Header="Вид" Binding="{Binding ins_InsuranceTypes.TypeName}" Width="150"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding InsuredSum, StringFormat=N2}" Width="120"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding ConclusionDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
                    <Button Content="✅ Одобрить" Click="BtnApproveContract_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="{StaticResource GreenBrush}"
                            Padding="20,10" Margin="0,0,10,0"/>
                    <Button Content="❌ Отклонить" Click="BtnRejectContract_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="{StaticResource RedBrush}"
                            Padding="20,10"/>
                </StackPanel>
            </Grid>

            <!-- Выплаты -->
            <Grid x:Name="pnlCases" Margin="30" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Запросы на выплату" Style="{StaticResource HeaderTextStyle}"/>
                    <TextBlock Style="{StaticResource SubHeaderTextStyle}" Margin="0,5,0,0"
                               Text="Страховые случаи, требующие решения"/>
                </StackPanel>

                <DataGrid x:Name="dgPendingCases" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="White" RowBackground="White"
                          AlternatingRowBackground="#F8F9FA" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding CaseID}" Width="50"/>
                        <DataGridTextColumn Header="Договор" Binding="{Binding ins_InsuranceContracts.ContractNumber}" Width="130"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding CaseDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding PaymentAmount, StringFormat=N2}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
                    <Button Content="✅ Одобрить выплату" Click="BtnApproveCase_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="{StaticResource GreenBrush}"
                            Padding="20,10" Margin="0,0,10,0"/>
                    <Button Content="❌ Отклонить" Click="BtnRejectCase_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="{StaticResource RedBrush}"
                            Padding="20,10"/>
                </StackPanel>
            </Grid>

            <!-- Отчёт -->
            <Grid x:Name="pnlReport" Margin="30" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Отчёт о страховых выплатах" Style="{StaticResource HeaderTextStyle}"/>
                    <TextBlock Style="{StaticResource SubHeaderTextStyle}" Margin="0,5,0,0"
                               Text="Выберите период и нажмите «Сформировать»"/>
                </StackPanel>

                <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="С:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <DatePicker x:Name="dpReportFrom" Width="150"/>
                        <TextBlock Text="По:" VerticalAlignment="Center" Margin="20,0,8,0" FontWeight="SemiBold"/>
                        <DatePicker x:Name="dpReportTo" Width="150"/>
                        <Button Content="Сформировать" Click="BtnGenerateReport_Click"
                                Style="{StaticResource BaseButtonStyle}"
                                Background="{StaticResource AccentBrush}"
                                Padding="20,8" Margin="20,0,0,0"/>
                        <TextBlock x:Name="lblReportSum" Margin="25,0,0,0" VerticalAlignment="Center"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="{StaticResource GreenBrush}"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="dgReport" Grid.Row="2"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="White" RowBackground="White"
                          AlternatingRowBackground="#F8F9FA" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding CaseDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Договор" Binding="{Binding ins_InsuranceContracts.ContractNumber}" Width="130"/>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding ins_InsuranceContracts.ins_Clients.LastName}" Width="150"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding PaymentAmount, StringFormat=N2}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Статусная строка -->
            <Border VerticalAlignment="Bottom" Background="White"
                    BorderBrush="#BDC3C7" BorderThickness="0,1,0,0" Padding="15,8">
                <TextBlock x:Name="lblStatus" FontSize="12"
                           Foreground="{StaticResource GreenBrush}" Text="Готово к работе"/>
            </Border>
        </Grid>
    </Grid>
</Window>