<Window x:Class="InsuranceApp.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Страховая компания — Администратор"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource LightBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- БОКОВАЯ ПАНЕЛЬ -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,25,20,0">
                    <TextBlock Text="🛡" FontSize="32" Foreground="White"/>
                    <TextBlock Text="Страховая" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,5,0,0"/>
                    <TextBlock Text="компания" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <Border Background="#34495E" CornerRadius="6" Padding="10" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Сотрудник" FontSize="11" Foreground="#95A5A6"/>
                            <TextBlock x:Name="lblUserName" FontSize="14" FontWeight="Bold"
                                       Foreground="White" Margin="0,2,0,0"/>
                            <TextBlock x:Name="lblRoleName" FontSize="11" Foreground="#E74C3C"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="15,25,15,0">
                    <Button Content="🏠  Главное меню" Click="BtnHome_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="Transparent" Height="40" Margin="0,0,0,5"
                            HorizontalContentAlignment="Left" Padding="15,0"/>
                    <Button Content="👥  Пользователи" Click="BtnUsers_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="Transparent" Height="40" Margin="0,0,0,5"
                            HorizontalContentAlignment="Left" Padding="15,0"/>
                    <Button Content="📋  Виды страхования" Click="BtnTypes_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="Transparent" Height="40"
                            HorizontalContentAlignment="Left" Padding="15,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="15,0,15,20">
                    <Button Content="🚪  Выйти" Click="BtnLogout_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="#E74C3C" Height="40"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ОБЛАСТЬ КОНТЕНТА -->
        <Grid Grid.Column="1">

            <!-- ГЛАВНОЕ МЕНЮ -->
            <Grid x:Name="pnlMenu" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,25">
                    <TextBlock Text="Главное меню администратора" Style="{StaticResource HeaderTextStyle}"/>
                    <TextBlock Text="Управление учётными записями и справочниками"
                               Style="{StaticResource SubHeaderTextStyle}" Margin="0,5,0,0"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" VerticalAlignment="Top">
                    <Button Click="BtnUsers_Click"
                            Style="{StaticResource TileButtonStyle}"
                            Background="#8E44AD">
                        <StackPanel>
                            <TextBlock Text="👥" FontSize="36" HorizontalAlignment="Center" Foreground="White"/>
                            <TextBlock Text="Пользователи" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" Foreground="White" Margin="0,6,0,2"/>
                            <TextBlock Text="Сотрудники и роли" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="#E8DAEF"/>
                        </StackPanel>
                    </Button>

                    <Button Click="BtnTypes_Click"
                            Style="{StaticResource TileButtonStyle}"
                            Background="{StaticResource AccentBrush}">
                        <StackPanel>
                            <TextBlock Text="📋" FontSize="36" HorizontalAlignment="Center" Foreground="White"/>
                            <TextBlock Text="Виды страхования" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" Foreground="White" Margin="0,6,0,2"/>
                            <TextBlock Text="Справочник услуг" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="#D6EAF8"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>

            <!-- ПОЛЬЗОВАТЕЛИ -->
            <Grid x:Name="pnlUsers" Margin="30" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Управление пользователями" Style="{StaticResource HeaderTextStyle}"/>
                    <TextBlock x:Name="lblUsersSubtitle"
                               Style="{StaticResource SubHeaderTextStyle}" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                    <Button Content="➕ Добавить сотрудника" Click="BtnAddUser_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="{StaticResource GreenBrush}" Padding="15,8" Margin="0,0,10,0"/>
                    <Button Content="✏ Редактировать" Click="BtnEditUser_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="{StaticResource AccentBrush}" Padding="15,8" Margin="0,0,10,0"/>
                    <Button Content="🔑 Сбросить пароль" Click="BtnResetPassword_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="{StaticResource OrangeBrush}" Padding="15,8" Margin="0,0,10,0"/>
                    <Button Content="🗑 Удалить" Click="BtnDeleteUser_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="{StaticResource RedBrush}" Padding="15,8"/>
                </StackPanel>

                <DataGrid x:Name="dgUsers" Grid.Row="2"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="White" RowBackground="White"
                          AlternatingRowBackground="#F8F9FA" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding UserID}" Width="50"/>
                        <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="130"/>
                        <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="130"/>
                        <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="120"/>
                        <DataGridTextColumn Header="Отчество" Binding="{Binding MiddleName}" Width="130"/>
                        <DataGridTextColumn Header="Роль" Binding="{Binding ins_Roles.RoleName}" Width="140"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ВИДЫ СТРАХОВАНИЯ -->
            <Grid x:Name="pnlTypes" Margin="30" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Справочник видов страхования" Style="{StaticResource HeaderTextStyle}"/>
                    <TextBlock x:Name="lblTypesSubtitle"
                               Style="{StaticResource SubHeaderTextStyle}" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                    <Button Content="➕ Добавить вид" Click="BtnAddType_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="{StaticResource GreenBrush}" Padding="15,8" Margin="0,0,10,0"/>
                    <Button Content="🗑 Удалить" Click="BtnDeleteType_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="{StaticResource RedBrush}" Padding="15,8"/>
                </StackPanel>

                <DataGrid x:Name="dgTypes" Grid.Row="2"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="White" RowBackground="White"
                          AlternatingRowBackground="#F8F9FA" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding TypeID}" Width="80"/>
                        <DataGridTextColumn Header="Название вида страхования" Binding="{Binding TypeName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Статусная строка -->
            <Border VerticalAlignment="Bottom" Background="White"
                    BorderBrush="#BDC3C7" BorderThickness="0,1,0,0" Padding="15,8">
                <TextBlock x:Name="lblStatus" FontSize="12"
                           Foreground="{StaticResource GreenBrush}" Text="Готово к работе"/>
            </Border>
        </Grid>
    </Grid>
</Window>