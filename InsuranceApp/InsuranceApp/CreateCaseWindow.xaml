<Window x:Class="InsuranceApp.CreateCaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление страхового случая"
        Height="620" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource LightBgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource OrangeBrush}" Padding="20,18">
            <StackPanel>
                <TextBlock Text="Запрос на страховую выплату" FontSize="18"
                           FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Опишите страховой случай для рассмотрения"
                           FontSize="11" Foreground="#FAE5D3" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <TextBlock Text="Договор *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbContract" Height="34" Margin="0,0,0,12"
                          DisplayMemberPath="ContractNumber" SelectedValuePath="ContractID"/>

                <TextBlock Text="Дата страхового случая *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DatePicker x:Name="dpCaseDate" Height="34" Margin="0,0,0,12"/>

                <TextBlock Text="Описание случая *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtDescription" Height="120" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Сумма выплаты (если известна)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtPaymentAmount" Height="34" Margin="0,0,0,10"/>

                <Border Background="#FEF9E7" CornerRadius="6" Padding="12">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#7D6608"
                               Text="ℹ  Запрос будет отправлен андеррайтеру. Сумма выплаты может быть скорректирована при рассмотрении."/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#BDC3C7"
                BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Click="BtnCancel_Click"
                        Style="{StaticResource BaseButtonStyle}"
                        Background="#95A5A6" Padding="20,10" Margin="0,0,10,0"/>
                <Button Content="Отправить запрос" Click="BtnSave_Click"
                        Style="{StaticResource BaseButtonStyle}"
                        Background="{StaticResource OrangeBrush}" Padding="20,10"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>