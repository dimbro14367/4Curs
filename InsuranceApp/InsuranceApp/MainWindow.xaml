<Window x:Class="InsuranceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Страховая компания — Вход"
        Height="520" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ: брендинг -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                <TextBlock Text="🛡" FontSize="64" HorizontalAlignment="Center" Foreground="White"/>
                <TextBlock Text="Страховая" FontSize="28" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                <TextBlock Text="компания" FontSize="28" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Информационно-справочная система"
                           Foreground="#BDC3C7" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,20,0,0"
                           TextAlignment="Center" TextWrapping="Wrap" Width="240"/>
            </StackPanel>
        </Border>

        <!-- ПРАВАЯ ПАНЕЛЬ: форма входа -->
        <Border Grid.Column="1" Background="White">
            <StackPanel VerticalAlignment="Center" Margin="50">
                <TextBlock Text="Добро пожаловать" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="Войдите в систему, чтобы продолжить"
                           Style="{StaticResource SubHeaderTextStyle}" Margin="0,5,0,30"/>

                <TextBlock Text="Логин" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtLogin" Height="38" Margin="0,0,0,15"/>

                <TextBlock Text="Пароль" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" Height="38" Margin="0,0,0,25"/>

                <Button Content="ВОЙТИ" Click="BtnLogin_Click"
                        Style="{StaticResource BaseButtonStyle}"
                        Height="45" FontSize="14"
                        Background="{StaticResource AccentBrush}"/>

                <TextBlock x:Name="lblError" Foreground="{StaticResource RedBrush}"
                           FontSize="12" HorizontalAlignment="Center"
                           Margin="0,15,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>